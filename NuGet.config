<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clearing inherited sources keeps a restore from silently resolving a package from a machine-level or hostile feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
